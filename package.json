{
  "name": "devlab-shared",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build --filter=!//",
    "build:packages": "turbo run build --filter=./packages/**",
    "dev": "turbo run dev --filter=!//",
    "dev:ui-docs": "pnpm --filter @yuva-devlab/ui-docs dev",
    "dev:ui-storybook": "pnpm --filter @yuva-devlab/ui-storybook storybook",
    "storybook": "turbo run storybook",
    "build-storybook": "turbo run build-storybook",
    "lint": "eslint . --max-warnings=0 && pnpm --filter @yuva-devlab/auth-py lint",
    "lint:fix": "eslint . --fix && pnpm --filter @yuva-devlab/auth-py lint:fix",
    "format": "prettier --write . && pnpm --filter @yuva-devlab/auth-py format",
    "format:check": "prettier --check . && pnpm --filter @yuva-devlab/auth-py format:check",
    "typecheck": "turbo run typecheck --filter=!//",
    "test": "turbo run test --filter=!//",
    "test:coverage": "turbo run test --filter=!// -- --coverage",
    "clean": "turbo run clean --filter=!//",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "validate": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run build && pnpm run test",
    "fix": "pnpm run format && pnpm run lint:fix",
    "changeset": "changeset",
    "version-packages": "changeset version && node scripts/sync-py-version.mjs",
    "release": "turbo run build && changeset publish",
    "prepare": "husky",
    "release:py": "node scripts/publish-py.mjs"
  },
  "packageManager": "pnpm@12.5.1",
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^9.39.1",
    "@yuva-devlab/cli": "workspace:*",
    "eslint": "^9.39.1",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.8",
    "turbo": "^2.11.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.47.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix --no-warn-ignored --max-warnings=0",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css,scss}": [
      "prettier --write"
    ],
    "*.py": [
      "uv run --with ruff ruff check --fix",
      "uv run --with ruff ruff format"
    ]
  }
}
