{
  "name": "@yuva-devlab/tokens",
  "version": "1.1.1",
  "description": "Design tokens, brand themes, and Tailwind CSS 4 preset bridge for Yuva DevLab",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "style": "./styles/styles.css",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.ts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./preset.css": "./styles/preset.css",
    "./styles.css": "./styles/styles.css",
    "./root.css": "./styles/root.css",
    "./themes/finai.css": "./styles/themes/finai.css",
    "./themes/orchestrai.css": "./styles/themes/orchestrai.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "styles"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist node_modules .turbo"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@yuva-devlab/eslint-config": "workspace:*",
    "@yuva-devlab/prettier-config": "workspace:*",
    "@yuva-devlab/typescript-config": "workspace:*",
    "eslint": "^9.39.1",
    "prettier": "^3.9.8",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  }
}
